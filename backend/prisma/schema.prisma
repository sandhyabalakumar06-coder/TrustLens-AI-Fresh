generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ScanType {
  URL
  EMAIL
  MESSAGE
  QR_CODE
  PAYMENT_SCREENSHOT
  DOCUMENT
  IMAGE
}

enum ScanStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scans Scan[]

  @@index([createdAt])
}

model Scan {
  id               String     @id @default(cuid())
  userId           String
  type             ScanType
  status           ScanStatus @default(PENDING)
  inputSummary     String      @db.VarChar(1000)
  trustScore       Int?
  scamProbability  Int?
  threatCategory   String?
  explanation      String?     @db.Text
  evidence         Json?
  recommendations  Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, status])
}